{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chicago-pipeline",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "pipeline.monroeresidential.com", "custom_domain": true }],
  // Required by `wrangler preview`, which Workers Builds runs for PR/branch preview builds.
  "previews": {},
  // Each preview gets https://<preview-name>-chicago-pipeline.<subdomain>.workers.dev
  "preview_urls": true
}
