---
import CtaBand from "./CtaBand.astro";
import { DATA_AS_OF } from "../lib/data-meta";
import { formatDate } from "../lib/format";
import { MONROE_URL, SITE_3F_URL } from "../lib/site-config";
---
<footer class="site-footer">
  <div class="container">
    <CtaBand />
  </div>
  <div class="container footer-meta">
    <span>Data as of {formatDate(DATA_AS_OF)} · <a href="/about">Sources &amp; methodology</a> · <a href="/about#suggest">Suggest a correction</a></span>
    <span class="footer-credits">
      © {new Date().getFullYear()} 3F Construction
      <a class="footer-logo" href={SITE_3F_URL}><img src="/brand/3f-logo.png" alt="3F Construction" width="86" height="20" /></a>
      <a class="footer-logo" href={MONROE_URL}><img src="/brand/monroe-logo.png" alt="Monroe Residential Partners" width="68" height="20" /></a>
    </span>
  </div>
</footer>
