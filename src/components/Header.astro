---
import { CONTACT_3F_URL, SITE_3F_URL } from "../lib/site-config";
---
<header class="site-header">
  <a class="brand" href="/">
    <img src="/brand/3f-logo.png" alt="3F Construction" width="137" height="32" />
    <span class="brand-divider" aria-hidden="true"></span>
    <span class="brand-product">Chicago Pipeline</span>
  </a>
  <nav class="site-nav" aria-label="Primary">
    <a class="nav-secondary" href="/about">About the data</a>
    <a class="nav-secondary" href={SITE_3F_URL}>3fconstruction.net</a>
    <a class="button" href={CONTACT_3F_URL}>Contact 3F</a>
  </nav>
</header>
