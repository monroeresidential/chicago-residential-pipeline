---
import markSvg from "../assets/brand/mark.svg?raw";
import { CONTACT_3F_URL, SITE_3F_URL } from "../lib/site-config";
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Chicago Pipeline by 3F Construction — home">
    <span class="brand-mark" aria-hidden="true" set:html={markSvg} />
    <span class="brand-text">
      <span class="brand-wordmark">Chicago Pipeline</span>
      <span class="brand-by">by 3F Construction</span>
    </span>
  </a>
  <nav class="site-nav" aria-label="Primary">
    <a class="nav-secondary" href="/about">About the data</a>
    <a class="nav-secondary" href={SITE_3F_URL}>3fconstruction.net</a>
    <a class="button" href={CONTACT_3F_URL}>Contact 3F</a>
  </nav>
</header>
