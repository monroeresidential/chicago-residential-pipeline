---
import Filters from "../components/Filters.astro";
import MapView from "../components/MapView.astro";
import ProjectList from "../components/ProjectList.astro";
import StatTiles from "../components/StatTiles.astro";
import Base from "../layouts/Base.astro";
import { DATA_AS_OF } from "../lib/data-meta";
import { sortProjects } from "../lib/filters";
import { formatDate, formatMoney, formatUnits } from "../lib/format";
import { toFeatureCollection } from "../lib/geojson";
import { loadProjects } from "../lib/load-projects";
import { countByStatus, totals } from "../lib/stats";
import { DEFAULT_PMTILES_URL } from "../map/style";
import "../styles/map.css";

const projects = loadProjects();
const t = totals(projects);
// Embedded so the map never waits on (or fails on) a second request. Same shape as /data/projects.geojson.
const projectsJson = JSON.stringify(toFeatureCollection(projects, DATA_AS_OF)).replace(/</g, "\\u003c");
const description = `Map of ${t.count} downtown Chicago office-to-residential conversions: ${formatUnits(t.units)} units, ${formatMoney(t.tpcMusd)}, tracked from planning to completion. By Monroe Residential.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Chicago Residential Pipeline: downtown office-to-residential conversions",
  description,
  url: Astro.site!.href,
  dateModified: DATA_AS_OF,
  spatialCoverage: { "@type": "Place", name: "Downtown Chicago, IL" },
  creator: { "@type": "Organization", name: "Monroe Residential Partners", url: "https://monroeresidential.com" },
  distribution: [
    { "@type": "DataDownload", encodingFormat: "application/geo+json", contentUrl: new URL("/data/projects.geojson", Astro.site).href },
    { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: new URL("/data/projects.csv", Astro.site).href },
    { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: new URL("/data/projects.json", Astro.site).href },
  ],
};
---
<Base title="Chicago Residential Pipeline | Office Conversions Map" description={description} jsonLd={jsonLd} markdownPath="/llms.txt" preconnect={[new URL(DEFAULT_PMTILES_URL).origin]} fullscreen>
  <div class="app-shell">
    <aside id="sidebar" class="sidebar" data-state="collapsed" aria-label="Projects">
      <button type="button" class="sheet-handle" aria-expanded="false" aria-controls="sidebar-body">
        <span class="sheet-grip" aria-hidden="true"></span>
        <span><span data-stat="count">{t.count}</span> projects · <span data-stat="units">{formatUnits(t.units)}</span> units</span>
      </button>
      <div class="sidebar-body" id="sidebar-body">
        <p class="eyebrow">Downtown Chicago</p>
        <h1 class="sidebar-title">Office-to-Residential Conversions</h1>
        <StatTiles totals={t} />
        <Filters counts={countByStatus(projects)} />
        <ProjectList projects={sortProjects(projects, "units")} />
        <div class="sidebar-cta">
          <p><strong>Have a project in mind?</strong>We live to talk about the next great project.</p>
          <a class="button" href="tel:+13122964855">(312) 296-4855</a>
        </div>
        <p class="as-of">Data as of {formatDate(DATA_AS_OF)} · <a href="/about">Sources &amp; methodology</a> · <a href="/about#suggest">Suggest a correction</a></p>
      </div>
    </aside>
    <MapView />
  </div>
  <script is:inline type="application/json" id="projects-data" set:html={projectsJson} />
  <script>
    // Paint the sidebar first, then fetch and start the map: statically importing MapLibre (~290 KB)
    // made the browser download and run it before the first frame (first paint waited for the map).
    // The phone sheet handle works immediately, even before the map code arrives.
    import { bindSheet } from "../scripts/sidebar";
    const sheet = bindSheet(document.getElementById("sidebar")!);
    const start = () => import("../scripts/map-app").then(({ startMapApp }) => startMapApp(sheet));
    requestAnimationFrame(() => setTimeout(start, 0));
  </script>
</Base>
